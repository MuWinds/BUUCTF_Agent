# 规则一律加根锚点（前缀 /）或写全路径。
# 教训：上一版沿用 Python 模板，其中一条裸 `lib/` 把 `src/lib/` 整个吞掉了 ——
# 前后端协议真源 events.ts 就在里面，git add 会静默失败。
# 裸目录名在任意层级都匹配，代价太大。

/node_modules/
/.pnpm-store/

# Rust workspace 的 target 在仓库根，各成员 crate 共用这一个
/target/
# 建立 workspace 之前遗留的输出目录，已不再写入，可以整个删掉
/src-tauri/target/
/dist/
/dist-ssr/
# Tauri 生成的平台工程
/src-tauri/gen/

# 应用运行时配置，含 API Key
/config.json
# fake-llm 连真实 LLM 用的配置，含 API Key。
# 模板 scripts/fake-llm/config.template.json 必须提交。
/scripts/fake-llm/config.json
.env
.env.local
*.local

/.vscode/
/.idea/
*.swp
.DS_Store
Thumbs.db
/nul

*.log
npm-debug.log*
pnpm-debug.log*

# 仓库已无 Python 代码，这几条只为防止误提交残留物
/.venv/
__pycache__/
